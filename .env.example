# Server-only Vercel Function variables. Never prefix these with VITE_.
RESEND_API_KEY=re_replace_with_your_api_key
CONTACT_TO_EMAIL=contact@robowear.space
CONTACT_FROM_EMAIL="RoboWear Website <website@forms.robowear.space>"

# Public site origin for Stripe Checkout success and cancel URLs.
# No path and no trailing slash. The API reads SITE_URL, then VITE_SITE_URL.
# Use https in production. http is accepted only for localhost or 127.0.0.1.
SITE_URL=https://www.robowear.space

# Stripe secret API key. Server only — never expose it to the Vite client.
# Use sk_test_... until you are ready to accept live payments.
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key

# Signing secret for POST /api/stripe-webhook (Stripe Dashboard → Developers → Webhooks).
# Required only for the optional team email after a deposit is paid.
# Checkout and the success page work without it.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# Not used by the hosted Checkout redirect. Add a publishable key only if you
# later embed Payment Elements. Never put the secret key in a VITE_ variable.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_if_you_embed_elements
